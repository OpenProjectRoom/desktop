{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productview.local/schemas/productview.schema.json",
  "title": "OpenBuildRoom project configuration",
  "type": "object",
  "required": ["schemaVersion", "project", "components", "connections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object", "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }, "version": { "type": "string" },
        "repository": { "type": "string", "pattern": "^https://" }
      }, "additionalProperties": false
    },
    "product": { "type": "object", "required": ["vision", "docsRoot", "roadmap", "documentation"], "properties": {
      "vision": { "$ref": "#/$defs/relativePath" },
      "docsRoot": { "$ref": "#/$defs/relativePath" },
      "backlogRoot": { "$ref": "#/$defs/relativePath" },
      "roadmap": { "type": "array", "items": { "type": "object", "required": ["id", "title", "status"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }, "status": { "enum": ["draft", "planned", "in-progress", "done"] },
        "relatedComponents": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }, "additionalProperties": false } },
      "documentation": { "type": "array", "items": { "type": "object", "required": ["id", "title", "path"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" }, "summary": { "type": "string" }
      }, "additionalProperties": false } },
      "northStar": { "type": "object", "required": ["name", "unit", "cadence", "measurements"], "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 240 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
        "cadence": { "enum": ["daily", "weekly", "monthly"] },
        "target": { "type": "number" },
        "measurements": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["date", "value"], "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "value": { "type": "number" },
          "note": { "type": "string", "maxLength": 240 }
        }, "additionalProperties": false } }
      }, "additionalProperties": false }
    }, "additionalProperties": false },
    "workspace": {
      "type": "object", "properties": {
        "startPage": { "enum": ["overview", "product", "vision", "north-star", "roadmap", "docs", "map", "spec", "runtime", "commands", "mcp", "tests", "data", "environment", "files", "issues", "activity"] },
        "additionalViews": { "type": "array", "items": { "enum": ["vision", "roadmap", "north-star", "commands"] }, "uniqueItems": true },
        "mcpServers": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "linkedFrom": { "type": "string", "minLength": 1 },
          "transport": { "enum": ["stdio", "http", "sse"] },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "$ref": "#/$defs/relativePath" },
          "url": { "type": "string", "minLength": 1 },
          "environment": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
          "authEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }, "additionalProperties": false } },
        "environment": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": { "type": "string", "maxLength": 240 }
        }, "additionalProperties": false } },
        "layout": { "enum": ["freeform"] },
        "chat": { "type": "object", "properties": {
          "enabled": { "type": "boolean" },
          "context": { "type": "array", "items": { "enum": ["specs", "components", "tests", "issues", "files"] }, "uniqueItems": true },
          "provider": { "enum": ["none", "codex", "claude"] }
        }, "additionalProperties": false }
      }, "additionalProperties": false
    },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "connections": { "type": "array", "items": { "type": "object", "required": ["from", "to", "label"], "properties": {
      "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }
    }, "additionalProperties": false } },
    "views": { "type": "object", "properties": {
      "files": { "type": "object", "properties": { "roots": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } } } },
      "specifications": { "type": "object", "properties": {
        "roots": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true },
        "links": { "type": "array", "items": { "type": "object", "required": ["spec"], "properties": {
          "spec": { "$ref": "#/$defs/relativePath" },
          "requirements": { "type": "array", "items": { "type": "string", "pattern": "^FR-[0-9]+$" }, "uniqueItems": true },
          "components": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "tests": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
        }, "additionalProperties": false } }
      }, "additionalProperties": false },
      "metrics": { "type": "object", "properties": { "source": { "enum": ["process", "prometheus", "opentelemetry", "none"] }, "display": { "type": "array", "items": { "enum": ["latency", "cpu", "memory", "requests", "errors"] } } } },
      "timeline": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
    }, "additionalProperties": false }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "position": { "type": "object", "required": ["x", "y"], "properties": {
      "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0 }
    }, "additionalProperties": false },
    "component": { "type": "object", "required": ["id", "kind", "name", "position"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["service", "commandTool", "database", "testSuite", "specification", "issues", "storage", "external"] },
      "name": { "type": "string", "minLength": 1 }, "icon": { "type": "string" }, "position": { "$ref": "#/$defs/position" },
      "path": { "$ref": "#/$defs/relativePath" }, "url": { "type": "string" },
      "runtime": { "type": "object", "required": ["command", "startup"], "properties": {
        "command": { "$ref": "#/$defs/command" }, "cwd": { "$ref": "#/$defs/relativePath" },
        "environment": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "url": { "type": "string" },
        "health": { "type": "string" }, "startup": { "const": "manual" }
      }, "additionalProperties": false },
      "cli": { "type": "object", "required": ["mode", "summary", "usage"], "properties": {
        "mode": { "enum": ["server", "task"] },
        "protocol": { "enum": ["stdio", "http", "other"] },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/relativePath" },
        "description": { "type": "string", "minLength": 1 },
        "usage": { "type": "string", "minLength": 1 },
        "helpCommand": { "$ref": "#/$defs/command" },
        "commands": { "type": "array", "items": { "type": "object", "required": ["name", "description"], "properties": {
          "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }
        }, "additionalProperties": false } },
        "options": { "type": "array", "items": { "type": "object", "required": ["flag", "description"], "properties": {
          "flag": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }
        }, "additionalProperties": false } },
        "examples": { "type": "array", "items": { "type": "object", "required": ["label", "command"], "properties": {
          "label": { "type": "string", "minLength": 1 }, "command": { "$ref": "#/$defs/command" }
        }, "additionalProperties": false } },
        "environment": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true }
      }, "additionalProperties": false },
      "tests": { "type": "object", "required": ["command"], "properties": {
        "command": { "$ref": "#/$defs/command" }, "cwd": { "$ref": "#/$defs/relativePath" },
        "environment": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
        "categories": { "type": "array", "items": { "type": "string" } },
        "cases": { "type": "array", "items": { "type": "object", "required": ["id", "name", "command"], "properties": {
          "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 1 },
          "command": { "$ref": "#/$defs/command" }
        }, "additionalProperties": false } }
      }, "additionalProperties": false },
      "data": { "type": "object", "properties": {
        "engine": { "type": "string" }, "connectionEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "viewer": { "type": "string" }, "path": { "$ref": "#/$defs/relativePath" }
      }, "additionalProperties": false },
      "integration": { "type": "object", "properties": {
        "provider": { "enum": ["github", "linear"] }, "repository": { "type": "string" },
        "teamId": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }
      }, "required": ["provider"], "additionalProperties": false }
    }, "allOf": [
      { "if": { "properties": { "kind": { "const": "service" } } }, "then": { "required": ["runtime"] } },
      { "if": { "properties": { "kind": { "const": "commandTool" } } }, "then": { "required": ["runtime", "cli"] } },
      { "if": { "properties": { "kind": { "const": "testSuite" } } }, "then": { "required": ["tests"] } },
      { "if": { "properties": { "kind": { "const": "specification" } } }, "then": { "required": ["path"] } },
      { "if": { "properties": { "kind": { "const": "issues" } } }, "then": { "required": ["integration"] } }
    ], "additionalProperties": false }
  }
}
